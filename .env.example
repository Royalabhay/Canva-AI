# -----------------------------------------------------------------------------
# Canva AI environment
# Copy to .env.local for local development. Values marked required must be set in
# production. Local development uses safe non-secret fallbacks where possible.
# -----------------------------------------------------------------------------

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth / Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Storage
SUPABASE_STORAGE_BUCKET_UPLOADS=uploads
SUPABASE_STORAGE_BUCKET_EXPORTS=exports
SUPABASE_STORAGE_BUCKET_TEMPLATES=templates
SUPABASE_STORAGE_BUCKET_BRAND_ASSETS=brand-assets
SIGNED_UPLOAD_URL_TTL_SECONDS=600
SIGNED_DOWNLOAD_URL_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=52428800

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# Rendering / export workers
RENDERING_SERVICE_URL=http://localhost:3001
RENDERING_SERVICE_TOKEN=dev-render-token
EXPORT_WEBHOOK_SECRET=dev-export-secret
CANVAS_RENDER_TIMEOUT_MS=30000

# Billing / Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_TEAM_MONTHLY_PRICE_ID=price_team_monthly
STRIPE_TEAM_ANNUAL_PRICE_ID=price_team_annual
